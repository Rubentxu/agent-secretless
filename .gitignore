# Rust
/target/
**/*.rs.bk

# dist's flat output directory. `packaging/stage-bundle.py` writes the compiled
# binaries there for dist to find, and they are 13 MB of build product per
# target. The `/target/` rule above is anchored to the repository root and does
# not cover this one; a binary committed by accident is a binary every future
# clone carries, and a staged one is invisible in a diff of source files.
/packaging/target/

# Python bytecode from the adversarial harness
__pycache__/
*.py[cod]

# SDDK runtime state and cycle artifacts are machine-owned, not source.
.sddk/
.atl/
*.sqlite
*.sqlite-journal

# Local agent runtime caches. `.guard/` is a graph-analysis cache emitted
# by some analysis skills (~20 MB JSON of nodes/edges per run); it is
# deterministic given the source but expensive to regenerate, and the
# output is keyed by content hash, so ignoring it is safe and saves a
# several-MB diff every time the cache is repopulated.
.guard/

# Local scratch
*.sock
.DS_Store
