{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Secretless Console",
  "version": "0.22.0",
  "identifier": "dev.agentsecretless.console",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Agent Secretless",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'; require-trusted-types-for 'script'",
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": []
  }
}
